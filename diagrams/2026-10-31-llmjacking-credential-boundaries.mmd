flowchart LR
  DEV["Developer / CI"] -->|"deploys approved secret references"| PLATFORM["Third-party AI developer / deployment platform"]
  PLATFORM -->|"workload identity / injected secret"| APP["Application or agent runtime"]
  APP -->|"scoped requests"| PROVIDER["AI provider API / Bedrock"]
  VAULT["Secrets manager"] -->|"controlled retrieval"| PLATFORM
  PLATFORM -.->|"incident: exposed environment variables"| LEAK["Compromised credentials"]
  LEAK -.->|"unauthorized model calls"| PROVIDER
  PROVIDER -->|"usage, model, source and cost telemetry"| MON["Independent monitoring"]
  MON -->|"threshold or anomaly"| SOC["Security response"]
  SOC -->|"revoke and rotate"| VAULT
  SOC -->|"contain and investigate"| PLATFORM
  SOC -->|"billing review"| FIN["Finance / provider support"]
  AUDIT["Immutable audit trail"] <-->|"evidence"| SOC